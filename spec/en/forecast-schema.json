{
	"missingValues": [""],
	"primaryKey": ["forecast_id"],
	"fields": [{
			"name": "forecast_id",
			"type": "string",
			"format": "default",
			"title": "Forecast ID",
			"description": "Unique identifier of a forecasted data point (poi at a time)",
			"constraints": {
				"required": true,
				"unique": true
			}
		},
		{
			"name": "poi_id",
			"type": "string",
			"format": "default",
			"title": "POI ID",
			"description": "POI Identifier for the forecast",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "forecast_date",
			"type": "date",
			"format": "default",
			"title": "Forecast Date",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "start_time",
			"type": "time",
			"format": "default",
			"title": "Start Time",
			"description": "Start time for forecast variable",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "end_time",
			"type": "time",
			"format": "default",
			"title": "End Time",
			"description": "End time for forecast variable",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "forecast_variable",
			"type": "string",
			"format": "default",
			"title": "Forecast Variable",
			"description": "The variable that is being forecast for the directional POI (i.e. ridership, volume, boardings, speed, etc.). Note that for volume, this would be a one-way volume.",
			"constraints": {
				"required": true,
				"enum": ["volume", "ridership", "boardings", "alightings", "speed", "travel-time", "hov2-volume", "hov3-volume"]
			}
		},
		{
			"name": "forecast_value",
			"type": "number",
			"format": "default",
			"title": "Forecast Value",
			"description": "Numeric value of the forecast",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "forecast_unit",
			"type": "string",
			"format": "default",
			"title": "Forecast Unit",
			"description": "Unit of the forecast value, e.g. AADT."
		},
		{
			"name": "forecast_type",
			"type": "string",
			"format": "default",
			"title": "Forecast Type",
			"description": "Method used to produce the forecast."
		}
	]
}