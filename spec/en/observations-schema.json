{
	"missingValues": [""],
	"primaryKey": ["obs_id"],
	"fields": [{
			"name": "obs_id",
			"type": "string",
			"format": "default",
			"title": "Observation ID",
			"description": "Unique identifier for observation",
			"constraints": {
				"required": true,
				"unique": true
			}
		},
		{
			"name": "poi_id",
			"type": "string",
			"format": "default",
			"title": "Point of Interest ID",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "observation_date",
			"type": "date",
			"format": "default",
			"title": "Observation Date",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "start_time",
			"type": "time",
			"format": "default",
			"title": "Start Time",
			"description": "Start time for observation variable",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "end_time",
			"type": "time",
			"format": "default",
			"title": "End Time",
			"description": "End time for observation variable",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "observation_variable",
			"type": "string",
			"format": "default",
			"title": "Observation Variable",
			"description": "i.e. volume, ridership, etc.",
			"constraints": {
				"required": true,
				"enum": ["volume", "ridership", "boardings", "alightings", "speed", "travel-time", "hov2-volume", "hov3-volume"]
			}
		},
		{
			"name": "observation_value",
			"type": "number",
			"format": "default",
			"title": "Observation Value",
			"description": "Value of the observation variable between start time and end time on the observation date.",
			"constraints": {
				"required": true
			}
		},
		{
			"name": "observation_unit",
			"type": "string",
			"format": "default",
			"title": "Observation Unit",
			"description": "Unit of the observation value, e.g. AADT."
		}
	]
}